# Copy to .env.local for local development and set the same values in your host.
# Mailchimp → Profile → Extras → API keys. Keep it secret; never commit it.
MAILCHIMP_API_KEY=
# Mailchimp → Audience → Settings → Audience name and defaults → Audience ID
MAILCHIMP_AUDIENCE_ID=
# "true" makes Mailchimp send a confirmation email first; otherwise people are added straight away
MAILCHIMP_DOUBLE_OPT_IN=false
# Optional tag added to every signup
MAILCHIMP_TAG=website
